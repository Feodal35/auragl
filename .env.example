# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://auraglow.de

# Email Notification Configuration (Optional - SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@auraglow.de
SMTP_PASS=your-smtp-password
SMTP_FROM="Aura Glow by Mürvet <info@auraglow.de>"
ADMIN_NOTIFICATION_EMAIL=info@auraglow.de

# Security Admin Secret (Fallback session token or pepper)
ADMIN_JWT_SECRET=aura-glow-production-secret-change-me
